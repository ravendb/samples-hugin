server {
    listen 80 default_server;
    server_name _;
    root /usr/lib/hugin/frontend;
    index index.html;

    location /api/ {
        proxy_pass http://127.0.0.1:3030;
        proxy_connect_timeout 5s;
        proxy_read_timeout 180s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
