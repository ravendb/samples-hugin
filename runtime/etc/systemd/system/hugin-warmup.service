[Unit]
Description=Warm Hugin embedding model and vector index
After=hugin.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=hugin
Group=hugin
EnvironmentFile=-/etc/default/hugin
ExecStart=/usr/local/sbin/hugin-warmup
RuntimeDirectory=hugin
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
TimeoutStartSec=420

[Install]
WantedBy=multi-user.target
