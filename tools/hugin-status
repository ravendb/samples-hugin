#!/usr/bin/env bash
set -uo pipefail
printf 'Hugin appliance status\n\n'
for service in hugin ravendb ollama hugin-warmup dnsmasq; do
  printf '%-18s %s\n' "$service" "$(systemctl is-active "$service" 2>/dev/null || true)"
done
printf '%-18s %s\n' "wpa_supplicant" \
  "$(pgrep -x wpa_supplicant >/dev/null 2>&1 && echo running || echo stopped)"
printf '\nNetwork\n'
printf 'SSID: %s\n' "$(iwgetid -r 2>/dev/null || echo AP/offline)"
ip -brief -4 address show dev wlan0 2>/dev/null || true
/usr/local/sbin/hugin-clients 2>/dev/null || true
printf '\nMemory and storage\n'
free -h
swapon --show 2>/dev/null || true
df -h /var/lib/ravendb 2>/dev/null || df -h /
printf '\nReadiness\n'
curl --silent --show-error --max-time 8 http://127.0.0.1:3030/api/boot-status || true
printf '\n'
