#!/usr/bin/env bash
set -Eeuo pipefail
# shellcheck source=tools/lib/wifi.sh
source "${HUGIN_WIFI_LIB:-/usr/local/lib/hugin/wifi.sh}"
wifi_require_root
if wifi_try_saved_client; then
  echo "connected using saved Wi-Fi configuration"
  exit 0
fi
echo "saved Wi-Fi unavailable; starting Hugin AP" >&2
wifi_apply_ap
